{
  "routes": [
    { "src": "/purchase", "dest": "/purchase.html" },
    { "src": "/tos", "dest": "/tos.html" },
    { "src": "/docs", "dest": "/docs.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
